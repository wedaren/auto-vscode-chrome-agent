{
  "name": "vscode-ext",
  "displayName": "Browser Agent",
  "description": "VSCode 插件 — Browser Agent 的 agent 大脑",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "browser-agent.ask",
        "title": "Browser Agent: 提问"
      },
      {
        "command": "browser-agent.connectDevtools",
        "title": "Browser Agent: 连接 DevTools MCP"
      },
      {
        "command": "browser-agent.generateReport",
        "title": "Browser Agent: 生成深度报告"
      },
      {
        "command": "browser-agent.clearMessageLog",
        "title": "Browser Agent: 清空消息日志",
        "icon": "$(clear-all)"
      },
      {
        "command": "browser-agent.runSkill",
        "title": "Browser Agent: 运行 Skill",
        "icon": "$(play)"
      },
      {
        "command": "browser-agent.toggleSkill",
        "title": "Browser Agent: 启用/禁用 Skill",
        "icon": "$(eye)"
      },
      {
        "command": "browser-agent.addCustomSkill",
        "title": "Browser Agent: 添加自定义 Skill",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "browser-agent.clearMessageLog",
          "when": "view == browser-agent-messages",
          "group": "navigation"
        },
        {
          "command": "browser-agent.addCustomSkill",
          "when": "view == browser-agent-skills",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "browser-agent.runSkill",
          "when": "view == browser-agent-skills && viewItem =~ /^skill-(preset|custom)-enabled$/",
          "group": "inline@1"
        },
        {
          "command": "browser-agent.toggleSkill",
          "when": "view == browser-agent-skills && viewItem =~ /^skill-(preset|custom)-(enabled|disabled)$/",
          "group": "inline@2"
        },
        {
          "command": "browser-agent.runSkill",
          "when": "view == browser-agent-skills && viewItem =~ /^skill-(preset|custom)-enabled$/",
          "group": "1_actions@1"
        },
        {
          "command": "browser-agent.toggleSkill",
          "when": "view == browser-agent-skills && viewItem =~ /^skill-(preset|custom)-(enabled|disabled)$/",
          "group": "1_actions@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "browser-agent-panel",
          "title": "Browser Agent",
          "icon": "resources/browser-agent.svg"
        }
      ]
    },
    "views": {
      "browser-agent-panel": [
        {
          "id": "browser-agent-connection",
          "name": "连接状态"
        },
        {
          "id": "browser-agent-messages",
          "name": "消息日志"
        },
        {
          "id": "browser-agent-agent-loop",
          "name": "Agent 循环"
        },
        {
          "id": "browser-agent-skills",
          "name": "Skill 管理"
        }
      ]
    },
    "configuration": {
      "title": "Browser Agent",
      "properties": {
        "browserAgent.port": {
          "type": "number",
          "default": 7777,
          "description": "WebSocket 服务端口号"
        },
        "browserAgent.userDataDir": {
          "type": "string",
          "default": "~/.browser-agent",
          "description": "用户数据持久化目录路径（支持 ~ 展开为用户 home 目录），存放 Skills、配置、会话记录等"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "dev": "tsc -watch -p ./tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  }
}
